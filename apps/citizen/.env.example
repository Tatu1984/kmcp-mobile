# Copy to .env. The app refuses to pretend to work without the API address.
EXPO_PUBLIC_API_URL=https://kmcp-backend.vercel.app/api/v1

# Android only, and optional. Without it the map degrades to a plain list of
# car parks and says why, rather than drawing an empty grey square. iOS uses
# Apple Maps and needs no key at all.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
